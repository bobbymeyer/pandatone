<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Pandatone" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%# Opts every same-origin navigation into the View Transitions API. %>
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Fetched in CORS mode even same-origin, hence crossorigin. %>
    <link rel="preload" href="<%= asset_path("archivo-variable-latin.woff2") %>"
          as="font" type="font/woff2" crossorigin>

    <%# Ordered by concern, not bundled: the grid defines the units the rest use. %>
    <%= stylesheet_link_tag "base", "grid", "type", "components", "transitions", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="masthead grid">
      <p class="masthead__mark"><%= link_to "Pandatone", root_path %></p>
      <nav class="masthead__nav">
        <%= link_to "Colours", colors_path %>
        <%= link_to "Palettes", palettes_path %>
        <%= link_to "Lookup", lookup_path %>
      </nav>
    </header>

    <main class="grid">
      <%= yield %>
    </main>
  </body>
</html>
