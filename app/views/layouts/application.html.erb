<%# What this app puts in the slots its_swiss/shell leaves. Everything else a
    layout used to have to remember — the view transition opt-in, the
    stylesheets, the importmap, a way past the masthead for a keyboard, and
    the flash — is the shell's.

    A layout rather than a `layout "its_swiss/shell"` on the controller,
    because these are set once for the whole app and content_for has to run
    while a view is rendering. The last line is what makes this a layout for
    the shell rather than a layout instead of it. %>
<% content_for :head do %>
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">

  <%# Fetched in CORS mode even same-origin, hence crossorigin. %>
  <link rel="preload" href="<%= asset_path("archivo-variable-latin.woff2") %>"
        as="font" type="font/woff2" crossorigin>

  <%# The library's six are the shell's. These are this app's, and unlayered,
      so they win wherever the two meet whatever order they arrive in. %>
  <%= stylesheet_link_tag "theme", "grid", "type", "components", "data-turbo-track": "reload" %>
<% end %>

<% content_for :mark do %>
  <%# The panda is decoration and hidden from a screen reader: the wordmark
      beside it already says the name. %>
  <span class="masthead__panda" aria-hidden="true">🐼</span><%= link_to "Pandatone", root_path %>
<% end %>

<%# current_page? answers for a destination, not for a section: it is false on
    /palettes/12, which is still where Palettes goes. Only this app knows that,
    which is why the library asks rather than working it out. %>
<% content_for :nav do %>
  <%= nav_link_to "Colors", colors_path, current: in_section?("colors") %>
  <%= nav_link_to "Palettes", palettes_path, current: in_section?("palettes") %>
  <%= nav_link_to "Lookup", lookup_path %>
  <%= nav_link_to "Account", account_path if authenticated? %>
<% end %>

<% content_for :main_class, "grid" %>

<%= render template: "layouts/its_swiss/shell" %>
