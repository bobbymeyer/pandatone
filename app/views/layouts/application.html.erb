<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Pandatone" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%# Opts every same-origin navigation into the View Transitions API. %>
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Fetched in CORS mode even same-origin, hence crossorigin. %>
    <link rel="preload" href="<%= asset_path("archivo-variable-latin.woff2") %>"
          as="font" type="font/woff2" crossorigin>

    <%# The library first, then this app's own. Order is a courtesy rather than
        a load-bearing decision: everything its-swiss ships is inside a cascade
        layer and nothing here is, so these win whatever order they arrive in. %>
    <%= its_swiss_stylesheet_tags %>
    <%= stylesheet_link_tag "theme", "grid", "type", "components", "transitions", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="masthead page">
      <%# The panda is decoration and hidden from a screen reader: the wordmark
          beside it already says the name. %>
      <p class="masthead__mark">
        <span class="masthead__panda" aria-hidden="true">🐼</span><%= link_to "Pandatone", root_path %>
      </p>
      <nav class="nav">
        <%= link_to "Colors", colors_path %>
        <%= link_to "Palettes", palettes_path %>
        <%= link_to "Lookup", lookup_path %>
        <%= link_to "Account", account_path if authenticated? %>
      </nav>
    </header>

    <main class="grid">
      <%= yield %>
    </main>
  </body>
</html>
