<li class="color-card" id="<%= dom_id(color) %>">
  <%# One link, not two to the same place: the swatch and its name were
      separate anchors, so every card cost two tab stops and announced its
      destination twice. %>
  <%= link_to color, class: "swatch-link" do %>
    <%# Shares its transition name with the swatch on the color's own page. %>
    <%= swatch_tag color.hex, transition_name: "color-#{color.id}", class: "swatch--card" %>
    <h2 class="color-card__name swatch-name"><%= color.name %></h2>
  <% end %>

  <%= hex_tag color.hex %>

  <p class="color-card__palettes">
    <% if color.palettes.empty? %>
      No palettes
    <% else %>
      <%= color.palettes.map(&:name).join(" · ") %>
    <% end %>
  </p>

  <% if color.tags.any? %>
    <p class="tags"><%= tag_links(color.tags) { |tag| colors_path(tag: tag) } %></p>
  <% end %>
</li>
