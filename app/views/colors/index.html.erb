<% content_for :title, "Colours" %>

<header class="page-head">
  <h1 class="page-title">Colours</h1>
  <p class="page-lede">
    Every swatch in the library, including those no palette has claimed yet.
  </p>

  <div class="page-actions">
    <%= link_to "New colour", new_color_path, class: "button button--primary" %>
  </div>
</header>

<section class="filters">
  <%= form_with url: colors_path, method: :get, class: "filter-form",
        data: { controller: "live-search", action: "input->live-search#search", turbo_frame: "colors" } do %>
    <%= hidden_field_tag :tag, params[:tag] if params[:tag].present? %>
    <%# Searching keeps the order you were reading in. Choosing an order is a
        whole navigation rather than a frame swap, so this is never stale. %>
    <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
    <div class="field">
      <%= label_tag :q, "Search" %>
      <%= text_field_tag :q, params[:q], autocomplete: "off" %>
    </div>
    <%= submit_tag "Filter", name: nil, class: "button" %>
  <% end %>

  <%= render "shared/filter_row", name: "tag", label: "Tagged",
        items: [ [ "All", colors_path(q: params[:q], sort: params[:sort]), params[:tag].blank? ] ] +
               @tags.map { |tag| [ tag, colors_path(tag: tag, q: params[:q], sort: params[:sort]),
                                   params[:tag] == tag ] } %>

  <%= render "shared/sort_filter", sorts: Color::SORTS %>
</section>

<%= turbo_frame_tag "colors", data: { turbo_action: "replace" }, target: "_top" do %>
  <p class="result-count"><%= result_count(@colors.size, @total, "colour") %></p>

  <% if @colors.empty? %>
    <% if @total.zero? %>
      <p class="empty">No colours yet. <%= link_to "Add the first one", new_color_path %>.</p>
    <% else %>
      <p class="empty">No colours match.</p>
    <% end %>
  <% else %>
    <ul class="color-list">
      <%= render partial: "colors/card", collection: @colors, as: :color %>
    </ul>
  <% end %>
<% end %>
