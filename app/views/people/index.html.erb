<% content_for :title, "People" %>

<header class="page-head">
  <h1 class="page-title">People</h1>
  <p class="page-lede">
    Sign ups are closed. An invited address may make an account, and making
    one takes it off the list.
  </p>
</header>

<section class="account">
  <%= render "shared/flash" %>

  <%= form_with url: invitations_path, class: "form form--inline" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "off" %>
    </div>

    <div class="field field--check">
      <%= form.check_box :admin %>
      <%= form.label :admin, "As an admin" %>
    </div>

    <%= form.submit "Invite", class: "button button--primary" %>
  <% end %>

  <h2>Accounts</h2>
  <ul class="people-list">
    <% @users.each do |user| %>
      <li>
        <span><%= user.email_address %><%= " · admin" if user.admin? %></span>

        <%# Not yourself: that is how a library ends up with nobody who can
            invite anybody. %>
        <% unless user == Current.user %>
          <%= button_to "Remove", user, method: :delete, class: "button button--danger",
                data: { turbo_confirm: "Remove #{user.email_address}? Their palettes and colors stay; the account does not." } %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @invitations.any? %>
    <h2>Invited</h2>
    <ul class="people-list">
      <% @invitations.each do |invitation| %>
        <li>
          <span><%= invitation.email_address %><%= " · as admin" if invitation.admin? %></span>

          <%= button_to "Withdraw", invitation, method: :delete, class: "button button--danger",
                data: { turbo_confirm: "#{invitation.email_address} will no longer be able to make an account. Withdraw it?" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
