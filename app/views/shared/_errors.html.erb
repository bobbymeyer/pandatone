<% if record.errors.any? %>
  <div class="errors">
    <p class="errors__title"><%= pluralize(record.errors.count, "problem") %> stopped this being saved.</p>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
