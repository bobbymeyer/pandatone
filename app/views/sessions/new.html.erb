<% content_for :title, "Sign in" %>

<header class="page-head">
  <h1 class="page-title">Sign in</h1>
  <p class="page-lede">This library is yours. Nothing in it is readable until you say who you are.</p>
</header>

<%= form_with url: session_path, class: "form" do |form| %>
  <%= render "shared/flash" %>

  <div class="field">
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
  </div>

  <div class="field">
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>

  <%= form.submit "Sign in", class: "button button--primary" %>
<% end %>

<p class="hint">
  <%= link_to "Forgot your password?", new_password_path, class: "link-quiet" %>
</p>
