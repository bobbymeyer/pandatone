<%# locals: (palette:, level: 2) %>
<%# The heading level is the caller's to set: a strip is the page's own
    content on the palette index, and a member of the "Palettes" section on a
    colour's page. One rule — an item sits one level under its section — held
    in one place. %>
<li class="palette-strip" id="<%= dom_id(palette) %>">
  <%= tag.send("h#{level}", link_to(palette.name, palette), class: "palette-strip__name") %>

  <%# The transition name is the membership, not the colour: one colour can sit
      in several palettes on this page, and a duplicate name would switch the
      morph off. %>
  <%= render "palettes/swatch_row", memberships: palette.palette_colors %>

  <p class="palette-strip__meta">
    <% if palette.tags.any? %>
      <span class="tags"><%= tag_links(palette.tags) { |tag| palettes_path(tag: tag) } %></span>
    <% end %>
    <span class="count"><%= pluralize(palette.palette_colors.size, "swatch", plural: "swatches") %></span>
  </p>
</li>
