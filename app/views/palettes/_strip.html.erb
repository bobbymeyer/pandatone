<li class="palette-strip" id="<%= dom_id(palette) %>">
  <h2 class="palette-strip__name"><%= link_to palette.name, palette %></h2>

  <div class="strip">
    <% palette.palette_colors.each do |membership| %>
      <%# The transition name is the membership, not the colour: one colour can
          sit in several palettes on this page, and a duplicate name would
          switch the morph off. %>
      <%= swatch_tag membership.color.hex,
            transition_name: "palette-color-#{membership.id}",
            title: "#{membership.color.name} #{membership.color.hex}" %>
    <% end %>
  </div>

  <p class="palette-strip__meta">
    <% if palette.tags.any? %>
      <span class="tags"><%= palette.tags.join(" · ") %></span>
    <% end %>
    <span class="count"><%= pluralize(palette.palette_colors.size, "swatch", plural: "swatches") %></span>
  </p>
</li>
