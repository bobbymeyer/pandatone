<% content_for :title, "Palettes" %>

<header class="page-head">
  <h1 class="page-title">Palettes</h1>

  <%# Making a palette is an action on this page, not one of its filters. %>
  <div class="page-actions">
    <%= link_to "New palette", new_palette_path, class: "button button--primary" %>
  </div>
</header>

<section class="filters">
  <%= form_with url: palettes_path, method: :get, class: "filter-form",
        data: { controller: "live-search", action: "input->live-search#search", turbo_frame: "palettes" } do %>
    <%= hidden_field_tag :tag, params[:tag] if params[:tag].present? %>
    <%# Searching keeps the order you were reading in. Choosing an order is a
        whole navigation rather than a frame swap, so this is never stale. %>
    <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
    <div class="field">
      <%= label_tag :q, "Search" %>
      <%= text_field_tag :q, params[:q], autocomplete: "off" %>
    </div>
    <%= submit_tag "Filter", name: nil, class: "button" %>
  <% end %>

  <%= render "shared/filter_row", name: "tag", label: "Tagged",
        items: [ [ "All", palettes_path(q: params[:q], sort: params[:sort]), params[:tag].blank? ] ] +
               @tags.map { |tag| [ tag, palettes_path(tag: tag, q: params[:q], sort: params[:sort]),
                                   params[:tag] == tag ] } %>

  <%= render "shared/sort_filter", sorts: Palette::SORTS %>
</section>

<%# Only the results live in the frame; the form stays outside it so typing
    does not replace the field under the cursor. %>
<%= turbo_frame_tag "palettes", data: { turbo_action: "replace" }, target: "_top" do %>
  <%# The count belongs with the results: outside the frame it would still
      read "4 palettes" after a search narrowed the list to one. %>
  <p class="result-count"><%= result_count(@palettes.size, @total, "palette") %></p>

  <% if @palettes.empty? %>
    <%# A library with nothing in it is a different state from a search that
        found nothing, and on a first run the second reading is simply wrong. %>
    <% if @total.zero? %>
      <p class="empty">No palettes yet. <%= link_to "Make the first one", new_palette_path %>.</p>
    <% else %>
      <p class="empty">No palettes match.</p>
    <% end %>
  <% else %>
    <ul class="palette-list">
      <%= render partial: "palettes/strip", collection: @palettes, as: :palette %>
    </ul>
  <% end %>
<% end %>
