<% content_for :title, @palette.name %>

<header class="page-head">
  <h1 class="page-title"><%= @palette.name %></h1>

  <%= turbo_frame_tag "palette_tags" do %>
    <div class="inline-edit">
      <p class="tags"><%= @palette.tags.any? ? tag_links(@palette.tags) { |tag| palettes_path(tag: tag) } : "Untagged" %></p>
      <%= link_to "Edit tags", edit_palette_tags_path(@palette), class: "link-quiet" %>
    </div>
  <% end %>

  <div class="page-actions">
    <%= link_to "Add a swatch", new_palette_color_path(@palette), class: "button button--primary" %>
    <%= link_to "Edit palette", edit_palette_path(@palette), class: "button" %>
    <%# Not "duplicate": the one thing it will not make is a copy. %>
    <%= link_to "New from this", new_palette_path(from: @palette.id), class: "button" %>
    <%# The only thing in this app that cannot be undone. %>
    <%= button_to "Delete palette", @palette, method: :delete, class: "button button--danger",
          data: { turbo_confirm: "Delete #{@palette.name} and its swatch order? The colors stay in the library." } %>
  </div>
</header>

<%= render "shared/errors", record: @palette %>

<% if @palette.palette_colors.empty? %>
  <p class="empty">No swatches yet. <%= link_to "Add the first one", new_palette_color_path(@palette) %>.</p>
<% else %>
  <ol class="swatch-grid">
    <% memberships = @palette.palette_colors.to_a %>
    <% memberships.each_with_index do |membership, index| %>
      <% color = membership.color %>
      <li class="swatch-detail" id="<%= dom_id(membership) %>">
        <%= link_to color, class: "swatch-link" do %>
          <%= swatch_tag color.hex, transition_name: "palette-color-#{membership.id}", class: "swatch--card" %>
          <h2 class="swatch-name"><%= color.name %></h2>
        <% end %>

        <%= hex_tag color.hex %>

        <dl class="channels">
          <% channel_pairs(color).each do |space, values| %>
            <dt><%= space %></dt>
            <dd><% values.each do |key, value| %><span class="channel"><span class="channel__key"><%= key %></span> <%= value %></span><% end %></dd>
          <% end %>
        </dl>

        <div class="swatch-detail__controls">
          <%# No control where there is nowhere to go, rather than one that
              silently does nothing at the ends of the row. %>
          <% if index.positive? %>
            <%= button_to "Up", move_palette_color_path(@palette, color, direction: "up"),
                  method: :patch, class: "button button--quiet",
                  aria: { label: "Move #{color.name} earlier" } %>
          <% end %>

          <% if index < memberships.size - 1 %>
            <%= button_to "Down", move_palette_color_path(@palette, color, direction: "down"),
                  method: :patch, class: "button button--quiet",
                  aria: { label: "Move #{color.name} later" } %>
          <% end %>

          <%= button_to "Remove", palette_color_path(@palette, color),
                method: :delete, class: "button button--danger" %>
        </div>
      </li>
    <% end %>
  </ol>
<% end %>

<%# Last on the page, because it is the one thing here that takes the palette
    somewhere else rather than changing it. Two formats, because between them
    they cover where these colors actually go: a design tool, and a
    stylesheet. %>
<div class="export">
  <span class="export__label">Export</span>
  <ul class="link-list">
    <li><%= link_to "ASE", palette_path(@palette, format: :ase), class: "link-quiet" %></li>
    <li><%= link_to "CSS variables", palette_path(@palette, format: :css), class: "link-quiet" %></li>
  </ul>
</div>
