<% content_for :title, "Add a swatch to #{@palette.name}" %>

<header class="page-head">
  <h1 class="page-title">Add a swatch</h1>
  <p class="page-lede">To <%= link_to @palette.name, @palette %>.</p>
</header>

<%= render "shared/errors", record: @palette %>

<section class="library-picker">
  <h2>From the library</h2>

  <%= form_with url: new_palette_color_path(@palette), method: :get, class: "filter-form" do %>
    <div class="field">
      <%= label_tag :q, "Search" %>
      <%= text_field_tag :q, params[:q], autocomplete: "off" %>
    </div>
    <%= submit_tag "Filter", name: nil, class: "button" %>
  <% end %>

  <% if @available.empty? %>
    <p class="empty">
      <%= params[:q].present? ? "No colours match." : "Every colour in the library is already in this palette." %>
    </p>
  <% else %>
    <ul class="color-list">
      <% @available.each do |color| %>
        <li class="color-card" id="<%= dom_id(color) %>">
          <%# Not a link: you are picking here, not browsing away. %>
          <%= swatch_tag color.hex, class: "color-card__swatch" %>

          <h3 class="color-card__name"><%= color.name %></h3>
          <p class="hex"><%= color.hex %></p>

          <%= button_to "Add", palette_colors_path(@palette),
                params: { color_id: color.id },
                class: "button", aria: { label: "Add #{color.name}" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="new-color">
  <h2>Or enter a new colour</h2>

  <%= form_with url: palette_colors_path(@palette), class: "form" do %>
    <%= render "shared/swatch_fields" %>
    <%= submit_tag "Add swatch", name: nil, class: "button button--primary" %>
  <% end %>
</section>
