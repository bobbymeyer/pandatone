<% opening = User.none? %>
<% content_for :title, opening ? "Open the library" : "Create your account" %>

<header class="page-head">
  <h1 class="page-title"><%= opening ? "Open the library" : "Create your account" %></h1>
  <p class="page-lede">
    <% if opening %>
      Nobody has an account yet, so this one is yours and it is the admin.
      After it, nobody else gets in without an invitation from you.
    <% else %>
      Your address has been invited. Pick a password and the library is yours
      to work in.
    <% end %>
  </p>
</header>

<%= form_with url: registration_path, class: "form" do |form| %>
  <%= render "shared/flash" %>
  <%= render "shared/errors", record: @user %>

  <div class="field">
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: @user.email_address %>
  </div>

  <div class="field">
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <%= form.submit opening ? "Open the library" : "Create account", class: "button button--primary" %>
<% end %>
