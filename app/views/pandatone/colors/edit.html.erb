<%# One row per color is what makes the reverse lookup work, and it also
    means an edit here lands everywhere. Say so before, not after. %>
<%= page_head "Edit #{@color.name}",
      lede: (@color.palettes.any? ? "This color sits in #{pluralize(@color.palettes.size, "palette")}. Editing it changes every one of them." : nil) %>

<%= its_swiss_form_with url: color_path(@color), method: :patch do |form| %>
  <%= render "its_swiss/shared/errors", record: @color %>
  <%= render "pandatone/shared/similar_swatch", similar: @similar, color: @color if @similar %>
  <%= render "pandatone/shared/swatch_fields", color: @color %>
  <%= form.submit @similar ? "Save anyway" : "Save color" %>
<% end %>
