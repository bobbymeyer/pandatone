<% content_for :title, "Edit #{@color.name}" %>

<header class="page-head">
  <h1 class="page-title">Edit <%= @color.name %></h1>

  <% if @color.palettes.any? %>
    <%# One row per color is what makes the reverse lookup work, and it also
        means an edit here lands everywhere. Say so before, not after. %>
    <p class="lede">
      This color sits in <%= pluralize(@color.palettes.size, "palette") %>.
      Editing it changes every one of them.
    </p>
  <% end %>
</header>

<%= form_with url: color_path(@color), method: :patch, class: "form" do %>
  <%= render "its_swiss/shared/errors", record: @color %>
  <%= render "pandatone/shared/similar_swatch", similar: @similar, color: @color if @similar %>
  <%= render "pandatone/shared/swatch_fields", color: @color %>
  <%= submit_tag @similar ? "Save anyway" : "Save color", name: nil, class: "button button--primary" %>
<% end %>
