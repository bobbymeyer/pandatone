<%= page_head "New color", lede: "It joins the library on its own. Put it in a palette whenever you like." %>

<%= its_swiss_form_with url: colors_path do |form| %>
  <%= render "its_swiss/shared/errors", record: @color %>
  <%= render "pandatone/shared/similar_swatch", similar: @similar, color: @color if @similar %>
  <%= render "pandatone/shared/swatch_fields", color: @color.persisted? ? @color : nil %>
  <%= form.submit @similar ? "Create anyway" : "Create color" %>
<% end %>
