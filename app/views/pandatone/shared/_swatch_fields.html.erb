<%# locals: (color: nil) %>
<%# The color entry row, shared by the new-palette form, the add-a-swatch
    form and the edit-a-color form. Pass a color to prefill it. All four
    panels are rendered so the form works with JavaScript off; CSS :has()
    shows only the one whose mode is selected, and the Stimulus controller
    paints a live preview as you type. The server reads only the chosen
    mode's fields, so the hidden ones are inert.

    The fields are written by the library's builder, under the swatch scope
    every form on the page reads them from, whatever record the form around
    them is for. %>
<div class="swatch-entry__fields"
     data-controller="swatch-preview"
     data-swatch-preview-mode-value="<%= swatch_input_mode(color) %>">
  <%= fields_for :swatch, nil, builder: ItsSwiss::FormBuilder do |swatch| %>
    <%= swatch.text_field :name, label: "Swatch name", value: swatch_field_value(:name, color), autocomplete: "off" %>
    <%= swatch.text_field :tags, label: "Swatch tags", value: swatch_field_value(:tags, color), autocomplete: "off" %>

    <fieldset class="mode-toggle">
      <legend>Enter as</legend>
      <% { "rgb" => "RGB", "cmyk" => "CMYK", "hex" => "Hex", "picker" => "Picker" }.each do |mode, label| %>
        <%= swatch.radio_button :input_mode, mode, label: label, checked: swatch_input_mode(color) == mode,
              data: { swatch_preview_target: "mode", action: "change->swatch-preview#redraw" } %>
      <% end %>
    </fieldset>

    <div class="entry-panel" data-mode="rgb">
      <% %w[ r g b ].each do |channel| %>
        <%= swatch.number_field channel, label: channel.upcase, value: swatch_field_value(channel, color),
              min: 0, max: 255, step: 1,
              data: { swatch_preview_target: "rgb", action: "input->swatch-preview#redraw" } %>
      <% end %>
    </div>

    <div class="entry-panel" data-mode="cmyk">
      <% %w[ c m y k ].each do |channel| %>
        <%= swatch.number_field channel, label: channel.upcase, value: swatch_field_value(channel, color),
              min: 0, max: 100, step: 0.1,
              data: { swatch_preview_target: "cmyk", action: "input->swatch-preview#redraw" } %>
      <% end %>
    </div>

    <div class="entry-panel" data-mode="hex">
      <%= swatch.text_field :hex, label: "Hex value", value: swatch_field_value(:hex, color),
            autocomplete: "off", placeholder: "#E30613",
            data: { swatch_preview_target: "hex", action: "input->swatch-preview#redraw" } %>
    </div>

    <div class="entry-panel" data-mode="picker">
      <%= swatch.color_field :picker, label: "Pick a color", value: swatch_field_value(:picker, color).presence || "#000000",
            data: { swatch_preview_target: "picker", action: "input->swatch-preview#redraw" } %>
    </div>
  <% end %>

  <div class="preview" data-swatch-preview-target="group" hidden>
    <div class="swatch" data-swatch-preview-target="preview"></div>
    <p class="hex" data-swatch-preview-target="readout"></p>
  </div>
</div>
