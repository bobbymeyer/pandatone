<% content_for :title, "Tags for #{@palette.name}" %>

<%= turbo_frame_tag "palette_tags" do %>
  <%= its_swiss_form_with model: @palette, url: palette_tags_path(@palette), method: :patch, class: "form form--inline" do |form| %>
    <%= form.text_field :tag_list, label: "Tags", value: @palette.tag_list, autocomplete: "off" %>
    <%= form.submit "Save tags", class: "button" %>
    <%= link_to "Cancel", @palette, class: "link-quiet" %>
  <% end %>
<% end %>
