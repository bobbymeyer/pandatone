<%= page_head "Add a swatch", lede: safe_join([ "To ", link_to(@palette.name, @palette), "." ]) %>

<%= render "its_swiss/shared/errors", record: @palette %>

<% if @current.any? %>
  <section class="current-swatches">
    <h2>Already in this palette</h2>
    <%= render "pandatone/palettes/swatch_row", memberships: @current %>
  </section>
<% end %>

<%# The switch is CSS, not JavaScript: :has() on the checked radio, the same
    way the RGB/CMYK/hex/picker panels work. These radios are deliberately
    outside every form on the page — they choose what you see, they are not
    part of what gets submitted. The server decides which one starts checked,
    so a rejected submission comes back on the panel you were using. %>
<div class="add-swatch">
  <fieldset class="source-toggle">
    <legend>Add</legend>
    <% { "library" => "Existing swatch", "new" => "New color" }.each do |source, label| %>
      <span class="choice">
        <%= radio_button_tag :source, source, swatch_source == source, id: "swatch_source_#{source}" %>
        <%= label_tag "swatch_source_#{source}", label %>
      </span>
    <% end %>
  </fieldset>

  <section class="new-color" data-source="new">
    <%= its_swiss_form_with url: palette_colors_path(@palette) do |form| %>
      <%= render "pandatone/shared/similar_swatch", similar: @similar, color: @candidate if @similar %>
      <%= render "pandatone/shared/swatch_fields" %>
      <%= form.submit @similar ? "Add anyway" : "Add swatch" %>
    <% end %>
  </section>

  <section class="library-picker" data-source="library">
    <h2>Swatches in the library</h2>

    <div class="filters">
      <%= search_form new_palette_color_path(@palette), frame: "library", keep: { source: "library" } %>
    </div>

    <%# target: "_top" because this frame holds results, not an editable region:
    a link or an Add button inside it is going somewhere else entirely, and
    the destination has no frame by this name. Without it Turbo looks for one
    and renders "Content missing". The search form still drives the frame,
    since it names it explicitly. %>
<%= turbo_frame_tag "library", target: "_top" do %>
      <% if @available.empty? %>
        <p class="empty">
          <%= params[:q].present? ? "No colors match." : "Every color in the library is already in this palette." %>
        </p>
      <% else %>
        <ul class="grid cards color-list">
          <%= render partial: "pandatone/colors/card", collection: @available, as: :color,
                locals: { level: 3, pick: true, palette: @palette } %>
        </ul>
      <% end %>
    <% end %>
  </section>
</div>
