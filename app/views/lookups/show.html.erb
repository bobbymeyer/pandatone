<% content_for :title, "Look up a color" %>

<header class="page-head">
  <h1 class="page-title">Look up a color</h1>
  <p class="page-lede">Paste a swatch to find out which palettes already hold it. Hex, RGB or a CMYK build.</p>
</header>

<%= form_with url: lookup_path, method: :get, class: "form form--inline" do %>
  <div class="field">
    <%= label_tag :q, "Hex, RGB or CMYK" %>
    <%= text_field_tag :q, @query, autocomplete: "off", placeholder: "#E30613, 227, 6, 19 or 0, 97.4, 91.6, 11" %>
  </div>
  <%= submit_tag "Look up", name: nil, class: "button button--primary" %>
<% end %>

<% if @query.present? %>
  <% if @rgb.nil? %>
    <p class="empty">Could not read <q><%= @query %></q> as a hex, an RGB triple or a CMYK build.</p>
  <% else %>
    <section class="lookup-result">
      <%# When the lookup lands on exactly one stored color, the swatch takes
          that color's transition name, so following the link morphs the
          swatch across instead of crossfading the page under it. %>
      <% found = @colors.one? ? @colors.first : nil %>
      <%= swatch_tag @hex, class: "swatch--large",
            transition_name: found ? "color-#{found.id}" : "lookup-#{@hex.delete('#')}" %>

      <div class="lookup-result__body">
        <%= hex_tag @hex, class: "hex--large" %>

        <% if @build %>
          <%# Every color stores both spaces, so the search runs on the RGB
              the build renders to. Which build it came from is not recoverable
              from that, and saying so is the honest way to show a hit. %>
          <p class="provenance">
            Read as a CMYK build of
            <%= @build.map { |ink, value| "#{ink.to_s.upcase} #{value}" }.join(" ") %>,
            matched on the color it renders to.
          </p>
        <% end %>

        <% if @colors.empty? %>
          <%# The entry form reads the swatch row's own parameters, so handing
              it the hex here prefills the field and opens the hex panel with
              no special case at the other end. %>
          <div class="lookup-missing">
            <p class="empty">Not in the library.</p>
            <%= link_to "Add this color swatch",
                  new_color_path(swatch: { input_mode: "hex", hex: @hex }), class: "button" %>
          </div>

          <% if @nearest %>
            <h2>Closest stored color</h2>
            <div class="lookup-nearest">
              <%= swatch_tag @nearest.hex, class: "swatch--card" %>
              <p><%= link_to @nearest.name, @nearest %></p>
              <%= hex_tag @nearest.hex %>
            </div>
          <% end %>
        <% else %>
          <h2>Stored as</h2>
          <ul class="link-list">
            <% @colors.each do |color| %>
              <li><%= link_to color.name, color %></li>
            <% end %>
          </ul>
        <% end %>

        <h2>Palettes</h2>
        <% if @palettes.empty? %>
          <p class="empty">No palette holds this color.</p>
        <% else %>
          <ul class="link-list">
            <% @palettes.each do |palette| %>
              <li><%= link_to palette.name, palette %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
