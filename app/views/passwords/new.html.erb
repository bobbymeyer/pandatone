<% content_for :title, "Reset your password" %>

<header class="page-head">
  <h1 class="page-title">Reset your password</h1>
  <p class="page-lede">We will send a link to the address on the account.</p>
</header>

<%= form_with url: passwords_path, class: "form" do |form| %>
  <%= render "shared/flash" %>

  <div class="field">
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
  </div>

  <%= form.submit "Send reset instructions", class: "button button--primary" %>
<% end %>

<p class="hint"><%= link_to "Back to signing in", new_session_path, class: "link-quiet" %></p>
