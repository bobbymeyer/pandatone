<% content_for :title, "Set a new password" %>

<header class="page-head">
  <h1 class="page-title">Set a new password</h1>
  <p class="lede">Setting it signs out everywhere else you were signed in.</p>
</header>

<%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
  <div class="field">
    <%= form.label :password, "New password" %>
    <%= form.password_field :password, required: true, autofocus: true,
          autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "New password again" %>
    <%= form.password_field :password_confirmation, required: true,
          autocomplete: "new-password", maxlength: 72 %>
  </div>

  <%= form.submit "Save password", class: "button button--primary" %>
<% end %>
